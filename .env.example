# Copy to .env and fill in. .env is ignored by Git.

# Public URL of the app, as users reach it through the host's nginx (no trailing slash).
PUBLIC_URL=https://mywork.example.com

# Pocket ID base URL = OIDC issuer (no trailing slash).
POCKET_ID_URL=https://id.example.com

# OIDC client from Pocket ID (Administration → OIDC Clients).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 32-byte random secret for oauth2-proxy session cookies. Generate with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Host address and port where oauth2-proxy is published. Use 127.0.0.1 when
# nginx runs directly on the host; use the host's LAN IP (e.g. 10.0.0.100)
# when nginx runs in its own container (SWAG) and proxies to that IP.
BIND_ADDRESS=127.0.0.1
PORT=4180

# Optional: comma-separated Pocket ID group names allowed to use the API.
# Leave empty to rely on the user-group restriction on the OIDC client.
ALLOWED_GROUPS=

# Optional: client ID of a second Pocket ID client for Claude (remote MCP at
# ${PUBLIC_URL}/mcp). Leave empty to disable. See docs/self-hosting.md, "Use MyWork from Claude".
MCP_CLIENT_ID=

# Optional: email to task. A dedicated mailbox (e.g. mywork@example.com on
# Purelymail) that the app polls over IMAP; mail from addresses registered in
# the app becomes tasks. Leave user/password empty to disable.
# See docs/self-hosting.md, "Email to task".
# INBOUND_IMAP_HOST=imap.purelymail.com
# INBOUND_IMAP_USER=mywork@example.com
# INBOUND_IMAP_PASSWORD=
# Address shown in the app (defaults to INBOUND_IMAP_USER).
# INBOUND_ADDRESS=
# INBOUND_POLL_SECONDS=60
# Poll less often at night (local hours, TZ); empty INBOUND_NIGHT_HOURS = always poll at the day rate.
# INBOUND_NIGHT_HOURS=22-07
# INBOUND_NIGHT_POLL_SECONDS=3600
# Delete processed mail in MyWork/Imported and MyWork/Rejected after this many days (0 = keep forever).
# INBOUND_RETENTION_DAYS=30
# Time zone for due dates parsed from subjects.
# TZ=Europe/Oslo

# Optional session tuning.
# COOKIE_REFRESH=30m
# COOKIE_EXPIRE=168h

# Set to true only if login fails with "email in id_token isn't verified".
# ALLOW_UNVERIFIED_EMAIL=false

# Optional: app image. Default ghcr.io/haanok/mywork-selfhost:latest; pin a
# build with its sha tag, e.g. ghcr.io/haanok/mywork-selfhost:sha-1a2b3c4
# MYWORK_IMAGE=ghcr.io/haanok/mywork-selfhost:latest

# Optional: store data in a host directory instead of the mywork-data volume.
# The directory must exist and be writable by APP_UID:APP_GID, e.g. on Unraid:
#   mkdir -p /mnt/user/appdata/mywork/data && chown 99:100 /mnt/user/appdata/mywork/data
# DATA_PATH=/mnt/user/appdata/mywork/data
# APP_UID=99
# APP_GID=100
