# Copy to .env and fill in. .env is ignored by Git.

# Public URL of the app, as users reach it through the host's nginx (no trailing slash).
PUBLIC_URL=https://mywork.example.com

# Pocket ID base URL = OIDC issuer (no trailing slash).
POCKET_ID_URL=https://id.example.com

# OIDC client from Pocket ID (Administration → OIDC Clients).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 32-byte random secret for oauth2-proxy session cookies. Generate with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Host address and port where oauth2-proxy is published. Use 127.0.0.1 when
# nginx runs directly on the host; use the host's LAN IP (e.g. 10.0.0.100)
# when nginx runs in its own container (SWAG) and proxies to that IP.
BIND_ADDRESS=127.0.0.1
PORT=4180

# Optional: comma-separated Pocket ID group names allowed to use the API.
# Leave empty to rely on the user-group restriction on the OIDC client.
ALLOWED_GROUPS=

# Optional session tuning.
# COOKIE_REFRESH=30m
# COOKIE_EXPIRE=168h

# Set to true only if login fails with "email in id_token isn't verified".
# ALLOW_UNVERIFIED_EMAIL=false

# Optional: app image. Default ghcr.io/janfredrik/mywork-selfhost:latest; pin a
# build with its sha tag, e.g. ghcr.io/janfredrik/mywork-selfhost:sha-1a2b3c4
# MYWORK_IMAGE=ghcr.io/janfredrik/mywork-selfhost:latest
